<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="타브만든댕 — BPM · AI 기타 채보" Width="1280" Height="960" MinWidth="1020" MinHeight="850" Background="#F6F5F1" FontFamily="Malgun Gothic" FontSize="13" WindowStartupLocation="CenterScreen" AllowDrop="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="Background" Value="#EDF2E8"/><Setter Property="Foreground" Value="#2E6849"/><Setter Property="BorderBrush" Value="#D7E0D0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,7,0,17"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,7,0,17"/></Style>
 </Window.Resources>
 <Grid Margin="28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="≋  타브만든댕" FontSize="26" FontWeight="Bold" Foreground="#2E6849"/><TextBlock Text="노래를 듣고, 움직이는 타브를 따라 연주하세요." Foreground="#7B817B" Margin="2,8,0,0"/></StackPanel><TextBlock Text="DESKTOP STUDIO · 내 기기에서 분석" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#7B817B" FontSize="11"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="295"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="14" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="01  음원 준비" FontSize="17" FontWeight="Bold" Margin="0,0,0,17"/>
    <Button x:Name="OpenButton" Content="＋ 노래 파일 열기" Margin="0,0,0,9"/>
    <Button x:Name="DemoButton" Content="샘플 멜로디 불러오기" Margin="0,0,0,16"/>
    <TextBlock x:Name="FileLabel" Text="MP3 · WAV · M4A · WMA&#x0a;파일을 이 창에 끌어놓아도 돼요." TextWrapping="Wrap" Foreground="#7B817B" Margin="0,0,0,23"/>
    <Separator Margin="0,0,0,20"/><TextBlock Text="02  연주 설정" FontSize="17" FontWeight="Bold" Margin="0,0,0,20"/>
    <TextBlock Text="분석할 음원"/><ComboBox x:Name="InputMode" SelectedIndex="0"><ComboBoxItem Content="완성곡 · AI로 기타 먼저 분리"/><ComboBoxItem Content="기타만 있는 음원 · 직접 채보"/></ComboBox>
    <TextBlock Text="기타 파트"/><ComboBox x:Name="Part" SelectedIndex="0"><ComboBoxItem Content="리듬 기타 · 여러 음/코드 추정"/><ComboBoxItem Content="리드 기타 · 주 멜로디 추정"/></ComboBox>
    <TextBlock Text="기타 튜닝"/><ComboBox x:Name="Tuning" SelectedIndex="0"><ComboBoxItem Content="Standard · E A D G B e"/><ComboBoxItem Content="Drop D · D A D G B e"/><ComboBoxItem Content="반음 다운 · E♭ A♭ D♭ G♭ B♭ e♭"/></ComboBox>
    <TextBlock Text="최대 프렛"/><ComboBox x:Name="Frets" SelectedIndex="2"><ComboBoxItem Content="12 프렛" Tag="12"/><ComboBoxItem Content="17 프렛" Tag="17"/><ComboBoxItem Content="24 프렛" Tag="24"/></ComboBox>
    <TextBlock Text="분석 시작 시간 (초)"/><TextBox x:Name="Start" Text="0"/>
    <TextBlock Text="분석 길이"/><ComboBox x:Name="Length" SelectedIndex="3"><ComboBoxItem Content="30초" Tag="30"/><ComboBoxItem Content="60초" Tag="60"/><ComboBoxItem Content="90초" Tag="90"/><ComboBoxItem Content="시작부터 끝까지" Tag="1800"/></ComboBox>
    <Button x:Name="AnalyzeButton" Content="타브 만들기  ↗" Background="#2E6849" Foreground="White" IsEnabled="False" Margin="0,0,0,10"/>
    <Button x:Name="CancelButton" Content="분석 취소" Visibility="Collapsed" Margin="0,0,0,10"/>
    <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Foreground="#2E6849" Visibility="Collapsed"/>
   </StackPanel></ScrollViewer></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14"><TextBlock Text="03  박자와 마디를 따라 연주하기" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="Summary" Text="원곡의 박자를 분석하고, 기타를 분리해 타브를 만듭니다." Foreground="#7B817B" Margin="0,8,0,0" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,12,0,0"><TextBlock Text="BPM" VerticalAlignment="Center" Margin="0,0,5,8"/><TextBox x:Name="Bpm" Width="64" Margin="0,0,7,8" ToolTip="자동 추정 BPM. 반/두 배로 들리면 보정해주세요."/><Button x:Name="TempoHalf" Content="÷2" Margin="0,0,3,8" Padding="8,6"/><Button x:Name="TempoDouble" Content="×2" Margin="0,0,12,8" Padding="8,6"/><ComboBox x:Name="Meter" Width="77" SelectedIndex="0" Margin="0,0,10,8"><ComboBoxItem Content="4/4" Tag="4"/><ComboBoxItem Content="3/4" Tag="3"/><ComboBoxItem Content="6/8" Tag="6"/></ComboBox><TextBlock Text="첫 마디 (초)" VerticalAlignment="Center" Margin="0,0,5,8"/><TextBox x:Name="FirstBar" Text="0" Width="69" Margin="0,0,7,8"/><Button x:Name="ApplyRhythm" Content="박자 적용" Padding="10,7" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock x:Name="RhythmInfo" Text="BPM·박 위치는 자동 추정합니다. 박자표와 첫 마디는 확인 후 보정해주세요." FontSize="11" Foreground="#7B817B" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="8"><Grid x:Name="TabHost"/></Border>
    <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="18" Margin="0,16,0,0"><StackPanel>
     <DockPanel><TextBlock x:Name="Clock" Text="00:00.00 / 00:00.00" FontFamily="Consolas" FontSize="18" Foreground="#2E6849"/><TextBlock x:Name="BarPosition" Text="박자 분석 전" HorizontalAlignment="Right" Foreground="#2E6849"/></DockPanel><TextBlock x:Name="CurrentNote" Text="대기 중" Foreground="#7B817B" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
     <Slider x:Name="Timeline" Minimum="0" Maximum="1" Value="0" Margin="0,14,0,14" IsEnabled="False"/>
     <WrapPanel VerticalAlignment="Center"><Button x:Name="PlayButton" Content="▶ 재생" IsEnabled="False"/><Button x:Name="RestartButton" Content="↶ 분석 시작" IsEnabled="False"/><CheckBox x:Name="Loop" Content="구간 반복" VerticalAlignment="Center" Margin="4,0,14,0"/><CheckBox x:Name="Follow" Content="따라가기" IsChecked="True" VerticalAlignment="Center"/></WrapPanel>
     <WrapPanel Margin="0,15,0,0"><TextBlock Text="재생 속도" VerticalAlignment="Center" Margin="0,0,7,14"/><ComboBox x:Name="Speed" SelectedIndex="2" Width="87" Margin="0,0,16,14"><ComboBoxItem Content="0.5×" Tag="0.5"/><ComboBoxItem Content="0.75×" Tag="0.75"/><ComboBoxItem Content="1.0×" Tag="1"/><ComboBoxItem Content="1.25×" Tag="1.25"/></ComboBox><TextBlock Text="화면 범위" VerticalAlignment="Center" Margin="0,0,7,14"/><ComboBox x:Name="Zoom" SelectedIndex="0" Width="85" Margin="0,0,0,14"><ComboBoxItem Content="2마디" Tag="2"/><ComboBoxItem Content="4마디" Tag="4"/><ComboBoxItem Content="8마디" Tag="8"/></ComboBox></WrapPanel>
     <WrapPanel><Button x:Name="TextExport" Content="↓ TXT" IsEnabled="False"/><Button x:Name="JsonExport" Content="↓ JSON" IsEnabled="False"/><Button x:Name="StemExport" Content="↓ 분석한 기타 음원" IsEnabled="False"/></WrapPanel>
    </StackPanel></Border>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="Status" Text="노래를 선택해주세요. 설치된 로컬 AI 엔진으로 분석하며 외부 업로드는 하지 않습니다." TextWrapping="Wrap" Foreground="#2E6849"/><TextBlock Text="기타 분리 후 채보해도 오검출이 남을 수 있습니다. 박자표는 기본 4/4 가정 · 첫 마디 자동 확정 불가 · ? = 음역 밖/운지 배치 불가" TextWrapping="Wrap" Foreground="#8B9085" FontSize="11" Margin="0,7,0,0"/></StackPanel>
 </Grid>
</Window>
